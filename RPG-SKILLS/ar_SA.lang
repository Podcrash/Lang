pod_rpg.abilities.absorption.level4=+1 تأثير قابل للامتصاص
pod_rpg.abilities.absorption.level5=-10 ثواني تهدئة
pod_rpg.abilities.iron_will.name=إرادة حديدية
pod_rpg.abilities.iron_will.description=ما لا يقتلك يقويك. أثناء تفعيل هذه القدرة، سيزداد الضرر الناتج عن أي هجوم بنسبة ١٪ لكل تأثير سلبي يتعرض له اللاعب.
pod_rpg.abilities.iron_will.level1=+5 %% زيادة الضرر
pod_rpg.abilities.iron_will.level2=+5 %% زيادة الضرر
pod_rpg.abilities.iron_will.level3=+5 %% زيادة الضرر
pod_rpg.abilities.iron_will.level4=+5 %% زيادة الضرر
pod_rpg.abilities.iron_will.level5=+5 %% زيادة الضرر
pod_rpg.skills.sorcery.name=السحر
pod_rpg.skills.sorcery.description=يمكن رفع مستوى مهارة السحر بسحر العناصر. يمكنك الوصول إلى هذه القائمة عبر كتاب الإضافات أو بالنقر المزدوج بزر الماوس الأيمن أثناء الضغط على اللازورد أو كتاب أثناء التسلل.
pod_rpg.skills.sorcery.passive.description=توجد فرصة بنسبة %1 للاعب لاستعادة خبرته عند سحر أحد العناصر.
pod_rpg.skills.sorcery.abilities.description=قم بالتسلل مرتين أثناء حمل كتاب أو لازورد أو انقر بزر الماوس الأيمن مرتين أثناء حمل كتاب أو لازورد، لتمكين قدرتك السحرية.
pod_rpg.abilities.arcane_shield.name=درع غامض
pod_rpg.abilities.arcane_shield.description=سيظهر درع سحري حول اللاعب. عند تفعيله، سيطرد أي وحش. تدوم هذه القدرة ثانية واحدة.
pod_rpg.abilities.arcane_shield.level1=-10 ثواني تهدئة
pod_rpg.abilities.arcane_shield.level2=مدة +5 ثواني
pod_rpg.abilities.arcane_shield.level3=-10 ثواني تهدئة
pod_rpg.abilities.arcane_shield.level4=مدة +5 ثواني
pod_rpg.abilities.arcane_shield.level5=-10 ثواني تهدئة
pod_rpg.abilities.echoing_power.name=قوة الصدى
pod_rpg.abilities.echoing_power.description=أثناء تفعيل هذه القدرة، يُحدث كل سحر يُطبق على العنصر الذي يهاجم به اللاعب عدوًا صدى. يُلحق كل صدى ضررًا إضافيًا بنسبة %1 من الضرر السابق. تدوم هذه القدرة ثانيتين.
pod_rpg.abilities.echoing_power.level1=-15 ثانية فترة تهدئة
pod_rpg.abilities.echoing_power.level2=+20 %% ضرر
pod_rpg.abilities.echoing_power.level3=مدة +10 ثواني
pod_rpg.abilities.echoing_power.level4=+20 %% ضرر
pod_rpg.abilities.echoing_power.level5=-15 ثانية فترة تهدئة
