pod_rpg.abilities.poison_aura.level5=+10 सेकंड क्षमता अवधि
pod_rpg.abilities.absorption.name=अवशोषण
pod_rpg.abilities.absorption.description=जब यह क्षमता सक्रिय होती है, तो खिलाड़ी पर पड़ने वाले नकारात्मक प्रभावों को अवशोषित किया जा सकता है। हर %1 सेकंड में एक नकारात्मक प्रभाव अवशोषित किया जा सकता है। अधिकतम %2 प्रभाव अवशोषित किए जा सकते हैं।
pod_rpg.abilities.absorption.level1=-10 सेकंड कूलडाउन
pod_rpg.abilities.absorption.level2=+1 अवशोषक प्रभाव
pod_rpg.abilities.absorption.level3=-10 सेकंड कूलडाउन
pod_rpg.abilities.absorption.level4=+1 अवशोषक प्रभाव
pod_rpg.abilities.absorption.level5=-10 सेकंड कूलडाउन
pod_rpg.abilities.iron_will.name=पक्का इरदा
pod_rpg.abilities.iron_will.description=जो आपको नहीं मारता, वह आपको और भी मज़बूत बनाता है। जब तक यह क्षमता सक्रिय है, खिलाड़ी पर पड़ने वाले हर नकारात्मक प्रभाव के लिए, किसी भी हमले से होने वाला नुकसान %1 बढ़ जाएगा।
