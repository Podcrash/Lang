pod_rpg.abilities.echoing_power.name=प्रतिध्वनि शक्ति
pod_rpg.abilities.echoing_power.description=जब यह क्षमता सक्रिय होती है, तो खिलाड़ी जिस वस्तु से दुश्मन पर हमला करता है, उस पर पड़ने वाला प्रत्येक जादू एक प्रतिध्वनि उत्पन्न करेगा। प्रत्येक प्रतिध्वनि पिछली क्षति का %1 अतिरिक्त क्षति के रूप में देती है। यह क्षमता %2 सेकंड तक चलती है।
pod_rpg.abilities.echoing_power.level1=-15 सेकंड कूलडाउन
pod_rpg.abilities.echoing_power.level2=+20 %% क्षति
pod_rpg.abilities.echoing_power.level3=+10 सेकंड अवधि
pod_rpg.abilities.echoing_power.level4=+20 %% क्षति
pod_rpg.abilities.echoing_power.level5=-15 सेकंड कूलडाउन
pod_rpg.abilities.essence_drain.name=सार नाली
pod_rpg.abilities.essence_drain.description=जब यह क्षमता सक्रिय होती है, तो खिलाड़ी उन अन्य प्राणियों से अनुभव चुराता है जिन पर वह हमला कर रहा है। चुराया गया अनुभव यादृच्छिक होता है, लेकिन नुकसान के आधार पर। यह क्षमता %1 सेकंड तक चलती है।
pod_rpg.abilities.essence_drain.level1=-10 सेकंड कूलडाउन
pod_rpg.abilities.essence_drain.level2=+10 सेकंड अवधि
