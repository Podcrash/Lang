pod_rpg.skills.archer.is_not_charged=Not Charged
pod_rpg.abilities.triple_shot.name=Triple Shot
pod_rpg.abilities.triple_shot.description=When this ability is charged, the next bow shot will shoot 3 arrows instead of 1. Shooting will still only consume 1 arrow though! By default, the explosions on level 5 will break blocks, but you can disable explosion block damage in the Add-On settings.
