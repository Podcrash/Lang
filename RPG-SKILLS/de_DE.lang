pod_rpg.abilities.poison_aura.level5=+10 Sekunden Fähigkeitsdauer
pod_rpg.abilities.absorption.name=Absorption
pod_rpg.abilities.absorption.description=Während diese Fähigkeit aktiv ist, können negative Effekte, die auf den Spieler angewendet werden, absorbiert werden. Alle %1 Sekunden kann ein negativer Effekt absorbiert werden. Bis zu %2 Effekte können absorbiert werden.
pod_rpg.abilities.absorption.level1=-10 Sekunden Abklingzeit
pod_rpg.abilities.absorption.level2=+1 absorbierbarer Effekt
pod_rpg.abilities.absorption.level3=-10 Sekunden Abklingzeit
pod_rpg.abilities.absorption.level4=+1 absorbierbarer Effekt
pod_rpg.abilities.absorption.level5=-10 Sekunden Abklingzeit
pod_rpg.abilities.iron_will.name=Eiserner Wille
pod_rpg.abilities.iron_will.description=Was dich nicht umbringt, macht dich stärker. Während diese Fähigkeit aktiv ist, wird für jeden negativen Effekt, den der Spieler hat, der durch einen Angriff verursachte Schaden um %1 erhöht.
pod_rpg.abilities.iron_will.level1=+5%% Schadenssteigerung
pod_rpg.abilities.iron_will.level2=+5%% Schadenssteigerung
