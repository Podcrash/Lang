pod_farm.announce_update=§7[§qPhụ lục Nông nghiệp§7] §fĐã cập nhật lên §av%1§f. Kiểm tra Sổ Nông nghiệp của bạn để biết thêm thông tin!
pod_farm.guide.animals.0=§lBison
pod_farm.guide.animals.1=Bò rừng sống ở đồng bằng và rất thích ăn lúa mì. Tuy nhiên, hãy cẩn thận; khi bị thương, bò rừng sẽ hoảng sợ và tấn công bạn!%1
pod_farm.guide.animals.10=§lPeacock
pod_farm.guide.animals.11=Chim công, với bộ lông ấn tượng, chủ yếu được tìm thấy ở đồng bằng và rừng, nơi chúng thích ăn đậu, bông cải xanh, rau diếp và cả cải bắp.%1
pod_farm.guide.animals.12=§lChim cút
pod_farm.guide.animals.13=Nếu bạn tìm thấy một quả trứng lấp lánh kỳ lạ trên mặt đất, rất có thể cũng có một con chim cút ở gần đó. Bạn sẽ thấy chúng đang mổ hạt ở thảo nguyên, sa mạc, đồng bằng và rừng rậm.%1
pod_farm.guide.animals.14=§lThổ Nhĩ Kỳ
pod_farm.guide.animals.15=Gà tây sống ở những vùng tương đối lạnh; bạn có thể tìm thấy chúng ở đồng bằng băng giá, rừng taiga và rừng taiga tuyết phủ. Chúng tìm kiếm quả mọng và hạt để ăn suốt cả ngày!%1
pod_farm.guide.animals.16=§lYak
pod_farm.guide.animals.17=Bò Tây Tạng rất thích núi non và thường được tìm thấy trên các sườn núi phủ tuyết, đỉnh núi đóng băng, đồng cỏ và những ngọn đồi hiểm trở. Chúng ăn lúa mì và cũng là một nguồn sữa! Nhưng hãy cẩn thận; chúng sẽ sợ hãi và tấn công bạn nếu bị thương! %1% 1
pod_farm.guide.animals.2=§lQuạ
pod_farm.guide.animals.3=Quạ sẽ cố gắng phá hoại mùa màng của bạn. Bạn có thể xây Bù nhìn để dọa chúng!%1
pod_farm.guide.animals.4=§lDeer
pod_farm.guide.animals.5=Hươu thường ẩn náu trong rừng, nhưng đôi khi, khi tìm kiếm quả mọng, chúng cũng đi ra đồng bằng hoặc đồng cỏ.%1
pod_farm.guide.animals.6=§lVịt
pod_farm.guide.animals.7=Vịt thích sống gần nước. Bạn sẽ tìm thấy chúng quanh sông và đầm lầy; đôi khi, chúng còn bay! Chúng chỉ lên bờ để tìm hạt ăn thôi.%1
pod_farm.guide.animals.8=§lNgỗng
pod_farm.guide.animals.9=Ngỗng có sở thích tương tự như vịt. Chúng cũng sống ở sông và đầm lầy! Nhưng không giống vịt, ngỗng ăn quả mọng ngoài hạt.%1
pod_farm.guide.animals.title=Động vật
pod_farm.guide.changelog.1.0.10=-Đã sửa lỗi kết cấu Đậu hiển thị không chính xác%1-Đã sửa lỗi Bánh đào hiển thị thành Bánh táo trên Đĩa%1-Đã sửa lỗi Bánh táo không hiển thị trên Đĩa%1-Đã sửa lỗi bột xương tạo ra cỏ khi sử dụng trên cây ở chế độ sáng tạo%1-Đã sửa lỗi Dừa bị vỡ ngay lập tức khi xuất hiện ngẫu nhiên trong thế giới%1-Đã sửa lỗi Người chơi không thể mở cửa khi cầm hạt giống%1-Đã sửa lỗi công thức Cheeseburger chứa quá nhiều sắt (và tiêu tốn một Xô)%1-Đã sửa lỗi trùng lặp với Bình tưới nước khi đặt trên các khối cụ thể%1-Vũ khí có Khía cạnh Lửa giờ đây có thể nấu thịt khi dùng để giết động vật
pod_farm.guide.changelog.1.0.8=-Tỷ lệ cây đào sinh ra tăng%1-Tỷ lệ cây nho sinh ra tăng%1-Ngô hiện được kiểm tra sau khi đặt%1-Thay đổi vùng ảnh hưởng của mọi loại cây trồng thành rộng 1 khối%1-Thêm công thức chế tạo để có thể biến trái cây thành cây non%1-Giảm giới hạn xác thực xuống còn 20 loại cây trồng cho mỗi người chơi mỗi lần xác thực. (tối ưu hóa hiệu suất)%1-Tăng tần suất xác thực từ 30 tích tắc -> 6 tích tắc. (tối ưu hóa hiệu suất)
pod_farm.guide.changelog.1.0.9=-Thêm Burgers%1-Thêm Đĩa%1-Thêm Bình tưới nước%1-Thêm công thức chế tạo len bằng bông%1-Thêm công thức lò nung trứng chín bằng trứng cút%1-Thêm công thức chế tạo thuốc nhuộm đen bằng lông vũ đen%1-Thêm tab "Nhật ký thay đổi" vào sách hướng dẫn%1-Thêm tab "Cài đặt" vào sách hướng dẫn%1-Thêm một biến thể khác cho Yak%1-Chuyển đổi Máy ép trái cây thành Khối%1-Làm cho cây trồng có thể ủ phân%1-Làm cho trứng cút có thể ném%1-Làm cho một số cây trồng có thể thu hoạch mà không cần phải bẻ gãy%1-Căn chỉnh lại bộ định vị dây xích trên một số loài động vật%1-Đại tu nhiều kết cấu%1-Sửa lỗi một số loài động vật không thể nhân giống bằng hạt giống của chúng tôi%1-Sửa lỗi một số loài động vật có tỷ lệ sai khi lớn lên
